# ==============================================================
# DropThing Cloud Configuration (.env)
# ==============================================================

# Application Port & Secrets
PORT=5000
JWT_SECRET=dropthing-super-secret-key-production-2026

# ==============================================================
# 1. DATABASE CONFIGURATION
# ==============================================================
# Options: 'supabase' (PostgreSQL Cloud), 'turso' (Cloud SQLite), or 'local' (offline SQLite file)
DATABASE_PROVIDER=supabase

# --- Option A: Supabase PostgreSQL (100% Permanent Cloud Database) ---
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Option B: Turso (turso.tech) - 9 GB Free ---
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ==============================================================
# 2. FILE STORAGE CONFIGURATION
# ==============================================================
# Options: 
#   'local' -> local disk storage in server/uploads
#   's3'    -> Supabase S3 (1 GB Free, ZERO CARD NEEDED)
#   'r2'    -> Cloudflare R2 (10 GB Free, needs card verification)
STORAGE_PROVIDER=local

# --- Option A: Supabase S3 (100% Free, NO CREDIT CARD NEEDED) ---
# S3_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=<your-supabase-s3-access-key>
# S3_SECRET_ACCESS_KEY=<your-supabase-s3-secret-key>
# S3_BUCKET_NAME=dropthing-files

# --- Option B: Cloudflare R2 (10 GB Free, Zero Egress Fees) ---
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=dropthing-files

# ==============================================================
# 3. CORS & FRONTEND (For production deployment on Render/Vercel)
# ==============================================================
# FRONTEND_URL=https://dropthing.vercel.app
